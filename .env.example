# Copy to `.env` and fill in the blanks. In production this file is mounted
# into the container by docker-compose.yml.

# --- Cloudflare Turnstile (contact form spam protection) -------------------
# The sitekey is public and is served to the browser in a meta tag.
TURNSTILE_SITE_KEY="0x4AAAAAAEJbYCP3tk2ylm1z"
# The secret key is private and is only used server-side to validate tokens.
TURNSTILE_SECRET_KEY=""

# --- Contact form delivery -------------------------------------------------
FROM_EMAIL=""
TO_EMAIL=""
SMTP_USERNAME=""
# For Gmail this must be an app password, not the account password.
SMTP_PASSWORD=""

# --- URL shortener ---------------------------------------------------------
# Expected in the x-api-key header on POST /shorten_url.
URL_KEY=""
